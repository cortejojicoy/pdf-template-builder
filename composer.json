{
    "name": "kukux/pdf-template-builder",
    "description": "A drag-and-drop PDF template builder plugin for Filament Admin. Upload a PDF background, bind Eloquent model fields, and place them visually on the canvas.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "pdf",
        "template",
        "builder",
        "drag-drop"
    ],
    "authors": [
        {
            "name": "Jicoy Cortejo",
            "email": "jicoy.cortejo@gmail.com",
            "homepage": "https://github.com/pdf-template-builder"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.0 || ^4.0 || ^5.0",
        "illuminate/contracts": "^11.0 || ^12.0",
        "illuminate/database": "^11.0 || ^12.0",
        "illuminate/http": "^11.0 || ^12.0",
        "illuminate/routing": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "suggest": {
        "dompdf/dompdf": "Install to enable PDF output via the bundled DompdfEngine. Without it, the plugin returns HTML.",
        "setasign/fpdi": "Install with tecnickcom/tcpdf to enable FpdiEngine — true PDF overlay that preserves the original uploaded PDF.",
        "tecnickcom/tcpdf": "Required by FpdiEngine for unicode-aware PDF generation when stamping fields onto the original PDF."
    },
    "autoload": {
        "psr-4": {
            "Kukux\\PdfTemplateBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kukux\\PdfTemplateBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kukux\\PdfTemplateBuilder\\PdfTemplateBuilderServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}